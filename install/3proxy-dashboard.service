# /etc/systemd/system/3proxy-dashboard.service
[Unit]
Description=3proxy Dashboard
After=network.target 3proxy.service
Wants=3proxy.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/3proxy-dashboard
EnvironmentFile=/etc/3proxy-dashboard.env
ExecStart=/opt/3proxy-dashboard/venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --bind 127.0.0.1:18080 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
