# 3proxy 配置示例（install-3proxy.sh 安装时会自动生成 /etc/3proxy/3proxy.cfg）
# 用户格式： 用户名:CL:密码   —— 日常通过管理面板增删改，无需手改此文件
maxconn 100

nserver 1.1.1.1
nserver 8.8.8.8

timeouts 1 5 30 60 180 1800 15 60

log /var/log/3proxy/access.log
logformat "-L%t %U %C:%c %R:%r IN:%I OUT:%O H:%n D:%D E:%E"

auth strong

users demo:CL:CHANGE_ME

socks -p1234

flush
