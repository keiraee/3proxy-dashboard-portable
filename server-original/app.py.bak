from flask import Flask, render_template_string
import sqlite3
import os
import re
from datetime import datetime

LOG="/var/log/3proxy/access.log"
DB="/opt/3proxy-dashboard/data.db"

app = Flask(__name__)


def init_db():
    conn = sqlite3.connect(DB)
    c = conn.cursor()

    c.execute("""
    CREATE TABLE IF NOT EXISTS traffic(
        id INTEGER PRIMARY KEY,
        time TEXT,
        user TEXT,
        ip TEXT,
        target TEXT,
        download INTEGER,
        upload INTEGER
    )
    """)

    conn.commit()
    conn.close()



def parse_log():

    if not os.path.exists(LOG):
        return

    conn = sqlite3.connect(DB)
    c = conn.cursor()

    with open(LOG,"r",errors="ignore") as f:

        for line in f:

            if "IN:" not in line:
                continue

            try:

                parts=line.split()

                if len(parts)<6:
                    continue

                user=parts[1]

                if user=="-":
                    continue

                ip=parts[2].split(":")[0]
                target=parts[3]

                m=re.search(
                    r"IN:(\d+) OUT:(\d+)",
                    line
                )

                if not m:
                    continue


                download=int(m.group(1))
                upload=int(m.group(2))


                c.execute("""
                INSERT INTO traffic
                VALUES(NULL,?,?,?,?,?,?)
                """,
                (
                    datetime.now().isoformat(),
                    user,
                    ip,
                    target,
                    download,
                    upload
                ))

            except:
                pass


    conn.commit()
    conn.close()



@app.route("/")
def index():

    parse_log()

    conn=sqlite3.connect(DB)
    c=conn.cursor()

    data=c.execute("""
    SELECT
    user,
    SUM(download),
    SUM(upload),
    MAX(ip)
    FROM traffic
    GROUP BY user
    """).fetchall()


    html="""

<h2>3proxy Dashboard</h2>

<table border="1" cellpadding="8">

<tr>
<th>User</th>
<th>Download</th>
<th>Upload</th>
<th>Last IP</th>
</tr>


{% for x in data %}

<tr>

<td>{{x[0]}}</td>

<td>{{(x[1]/1024/1024)|round(2)}} MB</td>

<td>{{(x[2]/1024/1024)|round(2)}} MB</td>

<td>{{x[3]}}</td>

</tr>

{% endfor %}


</table>

"""


    return render_template_string(
        html,
        data=data
    )


if __name__=="__main__":

    init_db()

    app.run(
        host="0.0.0.0",
        port=18080
    )

